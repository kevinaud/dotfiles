#!/usr/bin/env bash

# Shell prompt based on the Solarized Dark theme.
# Screenshot: http://i.imgur.com/EkEtphC.png
# Heavily inspired by @necolas’s prompt: https://github.com/necolas/dotfiles
# iTerm → Profiles → Text → use 13pt Monaco with 1.1 vertical spacing.

dotfiles_prompt__ensure_term_capabilities() {
	if [[ $COLORTERM = gnome-* && $TERM = xterm ]] && infocmp gnome-256color >/dev/null 2>&1; then
		export TERM='gnome-256color';
	elif infocmp xterm-256color >/dev/null 2>&1; then
		export TERM='xterm-256color';
	fi;
}

dotfiles_prompt__lookup_branch() {
	git symbolic-ref --quiet --short HEAD 2>/dev/null || \
		git describe --all --exact-match HEAD 2>/dev/null || \
		git rev-parse --short HEAD 2>/dev/null || \
		echo '(unknown)'
}

dotfiles_prompt__repo_flags() {
	local symbols='';
	local repo_url;
	repo_url="$(git config --get remote.origin.url 2>/dev/null)";
	if [[ -n $repo_url ]] && grep -q 'chromium/src.git' <<<"${repo_url}"; then
		symbols='*';
	else
		if ! git diff --quiet --ignore-submodules --cached >/dev/null 2>&1; then
			symbols+='+';
		fi;
		if ! git diff-files --quiet --ignore-submodules >/dev/null 2>&1; then
			symbols+='!';
		fi;
		if [[ -n "$(git ls-files --others --exclude-standard 2>/dev/null)" ]]; then
			symbols+='?';
		fi;
		if git rev-parse --verify refs/stash >/dev/null 2>&1; then
			symbols+='$';
		fi;
	fi;
	if [[ -n $symbols ]]; then
		printf ' [%s]' "$symbols";
	fi;
}

dotfiles_prompt_git_segment() {
	local prefix="$1";
	local suffix="$2";

	git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0;

	local branch;
	branch="$(dotfiles_prompt__lookup_branch)";
	local flags;
	flags="$(dotfiles_prompt__repo_flags)";

	printf '%s%s%s%s' "${prefix}" "${branch}" "${suffix}" "${flags}";
}

dotfiles_prompt__init_colors() {
	if tput setaf 1 &>/dev/null; then
		tput sgr0;
		bold=$(tput bold);
		reset=$(tput sgr0);
		black=$(tput setaf 0);
		blue=$(tput setaf 33);
		cyan=$(tput setaf 37);
		green=$(tput setaf 64);
		orange=$(tput setaf 166);
		purple=$(tput setaf 125);
		red=$(tput setaf 124);
		violet=$(tput setaf 61);
		white=$(tput setaf 15);
		yellow=$(tput setaf 136);
	else
		bold='';
		reset='\e[0m';
		black='\e[1;30m';
		blue='\e[1;34m';
		cyan='\e[1;36m';
		green='\e[1;32m';
		orange='\e[1;33m';
		purple='\e[1;35m';
		red='\e[1;31m';
		violet='\e[1;35m';
		white='\e[1;37m';
		yellow='\e[1;33m';
	fi;
}

dotfiles_prompt__user_style() {
	if [[ ${USER} == 'root' ]]; then
		printf '%s' "${red}";
	else
		printf '%s' "${orange}";
	fi;
}

dotfiles_prompt__host_style() {
	if [[ -n ${SSH_TTY} ]]; then
		printf '%s' "${bold}${red}";
	else
		printf '%s' "${yellow}";
	fi;
}

dotfiles_prompt_build_ps1() {
	local user_style host_style git_command;
	user_style="$(dotfiles_prompt__user_style)";
	host_style="$(dotfiles_prompt__host_style)";
	printf -v git_command '$(dotfiles_prompt_git_segment "%s" "%s")' "\[${white}\] on \[${violet}\]" "\[${blue}\]";

	printf '%s' "\[\033]0;\W\007\]\[${bold}\]\n\[${user_style}\]\u\[${white}\] at \[${host_style}\]\h\[${white}\] in \[${green}\]\w${git_command}\n\[${white}\]\$ \[${reset}\]";
}

dotfiles_prompt_apply() {
	dotfiles_prompt__ensure_term_capabilities;
	dotfiles_prompt__init_colors;
	export PS1="$(dotfiles_prompt_build_ps1)";
	export PS2="\[${yellow}\]→ \[${reset}\]";
}

: "${DOTFILES_PROMPT_AUTOLOAD:=1}"
if [[ ${DOTFILES_PROMPT_AUTOLOAD} != 0 ]]; then
	dotfiles_prompt_apply;
fi;
